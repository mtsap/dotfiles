export ZSH="$HOME/.oh-my-zsh"

_source_if_readable() {
  [[ -r "$1" ]] && source "$1"
}

# History and shell behavior
HISTFILE="$HOME/.histfile"
HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_DUPS       # ignore only consecutive duplicates
setopt HIST_SAVE_NO_DUPS      # avoid writing older duplicate events to the history file
setopt SHARE_HISTORY

unsetopt beep
# bindkey -v

# Oh My Zsh
zstyle :compinstall filename "$HOME/.zshrc"

plugins=(
  zsh-pnpm-completions
  git
  extract
  vi-mode
  safe-paste
  node
  fzf-tab
  rust
  zsh-completions
  zsh-syntax-highlighting
)

source "$ZSH/oh-my-zsh.sh"

# Prompt
_source_if_readable /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme
_source_if_readable "$HOME/.p10k.zsh"

# Locale
export LC_ALL="en_US.UTF-8"
export LANG="en_US.UTF-8"
export LANGUAGE="en_US.UTF-8"

# FZF and fzf-tab
export FZF_DEFAULT_OPTS="
  --height=60%
  --layout=reverse
  --border=rounded
  --info=inline-right
  --cycle
  --scroll-off=3
  --tabstop=4
  --margin=1
  --padding=1
  --preview-window=right,55%,border-left,wrap
  --bind='ctrl-/:change-preview-window(right,55%,border-left,wrap|down,40%,border-top,wrap|hidden)'
  --preview='if [[ -d {} ]]; then eza --color=always --icons --tree --level=2 {} | head -200; elif [[ -f {} || -L {} ]]; then bat --theme="television-match" --color=always --style=plain --paging=never {} 2>/dev/null; else printf "%s\n" {}; fi'

  --color=bg:#272727,bg+:#2c2c2c,fg:#e6e6e6,fg+:#FFBF3C
  --color=hl:#E53935,hl+:#E53935,header:#FB8C00,info:#7f7f7f
  --color=border:#FB8C00,prompt:#FB8C00,spinner:#E53935
  --color=pointer:#FB8C00,marker:#FB8C00,gutter:#272727
  --color=separator:#FB8C00,scrollbar:#FB8C00
  --color=preview-border:#FB8C00,input-border:#FB8C00,list-border:#FB8C00
"

export FZF_CTRL_R_OPTS="
  --header='History'
  --preview 'echo {}'
  --preview-window=down,4,border-top,hidden,wrap
  --bind='?:toggle-preview'
"

zstyle ':fzf-tab:*' popup-border rounded
zstyle ':fzf-tab:*' popup-pad '1 1'

zstyle ':fzf-tab:*' fzf-flags \
  --height=70% \
  --border=rounded \
  --layout=reverse \
  --info=inline-right \
  --margin=1 \
  --padding=1 \
  --preview-window=right,50%,border-left,wrap \
  --prompt=' ' \
  --marker='● ' \
  --pointer='▶ ' \
  --color=bg:#272727,bg+:#2c2c2c,fg:#e6e6e6,fg+:#FFBF3C \
  --color=hl:#E53935,hl+:#E53935,header:#FB8C00,info:#7f7f7f \
  --color=border:#FB8C00,prompt:#FB8C00,spinner:#E53935 \
  --color=pointer:#FB8C00,marker:#FB8C00,gutter:#272727 \
  --color=separator:#FB8C00,scrollbar:#FB8C00 \
  --color=preview-border:#FB8C00,input-border:#FB8C00,list-border:#FB8C00 \
  --cycle

zstyle ':fzf-tab:*' switch-group 'ctrl-h' 'ctrl-l'
zstyle ':fzf-tab:*' group-colors \
  $'\e[38;2;127;127;127m' \
  $'\e[38;2;251;140;0m' \
  $'\e[38;2;229;57;53m' \
  $'\e[38;2;255;191;60m' \
  $'\e[38;2;189;189;189m' \
  $'\e[38;2;251;140;0m' \
  $'\e[38;2;229;57;53m' \
  $'\e[38;2;255;191;60m'

zstyle ':completion:*' list-colors ''
zstyle ':fzf-tab:*' prefix ''

zstyle ':fzf-tab:*' fzf-preview '
  if [[ -d "$realpath" ]]; then
      eza --color=always --icons --tree --level=2 "$realpath" | head -200
  else
      bat --theme="television-match" --color=always --style=plain --paging=never "$realpath" 2>/dev/null \
      || less "$realpath"
  fi
'

zstyle ':fzf-tab:complete:kill:*' fzf-preview 'ps -f -p "$word"'
zstyle ':fzf-tab:complete:cd:*' fzf-preview \
  'eza --color=always --icons --tree --level=2 "$realpath" | head -200'
zstyle ':fzf-tab:complete:git-checkout:*' fzf-preview \
  'git show --color=always "$word" 2>/dev/null || git branch --color=always'

_source_if_readable /usr/share/fzf/completion.zsh

# Tooling
_source_if_readable /usr/share/nvm/init-nvm.sh
_source_if_readable "$HOME/.zshaliases"
_source_if_readable "$HOME/.zshjdk15"
_source_if_readable "$HOME/.zshandroid"
_source_if_readable "$HOME/.zshwork"
_source_if_readable "$HOME/.config/zsh/worktrunk.zsh"
_source_if_readable "$HOME/.config/tabtab/zsh/__tabtab.zsh"
_source_if_readable "$HOME/.bun/_bun"

# Cloud SDKs
_source_if_readable "$HOME/bin/google-cloud-sdk/path.zsh.inc"
_source_if_readable "$HOME/bin/google-cloud-sdk/completion.zsh.inc"

# Interactive integrations
if command -v wt >/dev/null 2>&1; then
  eval "$(command wt config shell init zsh)"
fi

_source_if_readable "$HOME/.config/television/shell/integration.zsh"
_source_if_readable /usr/share/fzf/key-bindings.zsh
