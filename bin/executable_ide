#!/usr/bin/env zsh

set -euo pipefail

die() {
  print -u2 -- "error: $*"
  exit 1
}

usage() {
  print -u2 -- 'usage: ide'
}

require_cmd() {
  local cmd="$1"

  command -v "$cmd" >/dev/null 2>&1 || die "missing required command: $cmd"
}

ensure_reserved_windows_available() {
  local session_ref="$1"
  local current_window_id="$2"
  local line
  local window_id
  local window_name

  while IFS= read -r line; do
    window_id=${line%%|*}
    window_name=${line#*|}

    [[ "$window_id" == "$current_window_id" ]] && continue

    case "$window_name" in
      CODE|AI|SERVERS|MISC)
        die "window $window_name already exists in current session"
        ;;
    esac
  done < <(tmux list-windows -t "$session_ref" -F '#{window_id}|#{window_name}')
}

main() {
  local current_session_id
  local current_window_id
  local current_pane_id
  local session_ref
  local session_window_ref
  local ai_pane
  local servers_pane_1
  local servers_pane_2

  require_cmd tmux
  require_cmd nvim
  require_cmd opencode
  require_cmd pnpm
  require_cmd moonx

  if (( $# != 0 )); then
    print -u2 -- 'error: ide takes no arguments'
    usage
    exit 1
  fi

  [[ -n "${TMUX:-}" ]] || die "not inside tmux"

  current_session_id=$(tmux display-message -p '#{session_id}') || die "unable to resolve current tmux session"
  current_window_id=$(tmux display-message -p '#{window_id}') || die "unable to resolve current tmux window"
  current_pane_id=$(tmux display-message -p '#{pane_id}') || die "unable to resolve current tmux pane"

  ensure_reserved_windows_available "$current_session_id" "$current_window_id"

  session_ref="$current_session_id"
  session_window_ref="${session_ref}:"

  tmux kill-pane -a -t "$current_pane_id"
  tmux rename-window -t "$current_window_id" CODE

  ai_pane=$(tmux new-window -d -P -F '#{pane_id}' -t "$session_window_ref" -c "$PWD" -n AI)
  servers_pane_1=$(tmux new-window -d -P -F '#{pane_id}' -t "$session_window_ref" -c "$PWD" -n SERVERS)
  tmux new-window -d -t "$session_window_ref" -c "$PWD" -n MISC >/dev/null

  servers_pane_2=$(tmux split-window -d -h -t "$servers_pane_1" -c "$PWD" -P -F '#{pane_id}')
  tmux split-window -d -h -t "$servers_pane_2" -c "$PWD" >/dev/null
  tmux select-layout -t "$session_ref:SERVERS" even-horizontal >/dev/null

  tmux send-keys -t "$ai_pane" 'opencode' Enter
  tmux send-keys -t "$servers_pane_1" 'pnpm install && moonx run :build' Enter
  tmux select-window -t "$current_window_id"

  exec nvim
}

main "$@"
