{
	"$schema": "https://opencode.ai/config.json",
	"model": "codex-5.2",
	"small_model": "gpt-5.1-codex-mini",
	"autoupdate": true,
	"compaction": {
		"auto": true,
		"prune": true
	},
	"permission": {
		"edit": "allow",
		"bash": {
			"*": "ask",
			"git *": "ask",
			"git add *": "ask",
			"git commit *": "ask",
			"git push *": "ask",
			"git pull *": "ask",
			"git checkout *": "ask",
			"git branch *": "ask",
			"git log *": "allow",
			"git status *": "allow",
			"git diff *": "allow",
			"git remote *": "ask",
			"git config *": "ask",
			"read *": "allow",
			"npm *": "allow",
			"pnpm *": "allow",
			"bun *": "allow",
			"ls *": "allow",
			"rm *": "deny"
		},
		"webfetch": "allow"
	},
	"provider": {},
	"mcp": {
		"context7": {
			"enabled": true,
			"type": "remote",
			"url": "https://mcp.context7.com/mcp",
			"headers": {
				"CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
			}
		},
		"sentry": {
			"enabled": true,
			"type": "remote",
			"url": "https://mcp.sentry.dev/mcp",
			"oauth": {}
		}
	}
}
